# Параметры для scripts/seed.ts. НИКОГДА не коммитить заполненный файл (.env.seed.local в .gitignore).
# service_role нужен только чтобы создать пользователей; данные создаются через обычный API от их имени.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Пароль, который получат все тестовые пользователи
SEED_PASSWORD=
