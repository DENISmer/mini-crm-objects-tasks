-- Общие помощники для pgTAP-тестов. Подключается в каждом тесте через \ir.
-- Расширение .psql выбрано намеренно: pg_prove запускает только *.sql.
-- Всё создаётся внутри транзакции теста и откатывается вместе с ней.

create schema test_helpers;
grant usage on schema test_helpers to anon, authenticated;

-- Именованные фикстуры: ключ -> uuid. Нужны, потому что SQL внутри throws_ok()/lives_ok()
-- выполняется как строка, и psql-переменные туда не подставляются.
create table test_helpers.fixtures (key text primary key, id uuid not null);

create function test_helpers.remember(p_key text, p_id uuid)
returns uuid
language sql
security definer
set search_path = ''
as $$
  insert into test_helpers.fixtures (key, id) values (p_key, p_id)
  on conflict (key) do update set id = excluded.id
  returning id;
$$;

create function test_helpers.fx(p_key text)
returns uuid
language sql
stable
security definer
set search_path = ''
as $$
  select id from test_helpers.fixtures where key = p_key;
$$;

-- Пользователь в auth.users (профиль создаёт триггер on_auth_user_created).
create function test_helpers.create_user(p_key text, p_email text, p_role public.user_role, p_name text)
returns uuid
language plpgsql
set search_path = ''
as $$
declare
  v_id uuid := gen_random_uuid();
begin
  insert into auth.users (
    id, instance_id, aud, role, email, encrypted_password, email_confirmed_at,
    raw_app_meta_data, raw_user_meta_data, created_at, updated_at
  ) values (
    v_id, '00000000-0000-0000-0000-000000000000', 'authenticated', 'authenticated', p_email,
    extensions.crypt('password', extensions.gen_salt('bf')), now(),
    jsonb_build_object('provider', 'email', 'providers', jsonb_build_array('email'), 'role', p_role),
    jsonb_build_object('full_name', p_name), now(), now()
  );
  perform test_helpers.remember(p_key, v_id);
  return v_id;
end;
$$;

-- Эмуляция запроса через PostgREST от имени пользователя: роль authenticated + JWT claims.
create function test_helpers.login_as(p_key text)
returns void
language plpgsql
as $$
declare
  v_id uuid := test_helpers.fx(p_key);
begin
  perform set_config('request.jwt.claims', json_build_object('sub', v_id, 'role', 'authenticated')::text, true);
  perform set_config('request.jwt.claim.sub', v_id::text, true);
  perform set_config('role', 'authenticated', true);
end;
$$;

-- Запрос без входа (роль anon).
create function test_helpers.login_anon()
returns void
language plpgsql
as $$
begin
  perform set_config('request.jwt.claims', '{"role":"anon"}', true);
  perform set_config('request.jwt.claim.sub', '', true);
  perform set_config('role', 'anon', true);
end;
$$;

-- Возврат к владельцу БД (как service_role или SQL-редактор Dashboard).
create function test_helpers.logout()
returns void
language plpgsql
as $$
begin
  perform set_config('role', 'postgres', true);
  perform set_config('request.jwt.claims', '', true);
  perform set_config('request.jwt.claim.sub', '', true);
end;
$$;

grant execute on all functions in schema test_helpers to anon, authenticated;
